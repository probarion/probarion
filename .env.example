# Probarion environment variables (interfaces §14).
# Copy to .env and fill in. Never commit .env. Secrets stay empty in this file.

# --- NEAR (all packages)
# The web app serves testnet and mainnet at once (docs/runbooks/web-deploy.md, "Both networks in one project"). The network
# of a request is the address it was opened at. NEAR_NETWORK is the DEFAULT network: the network of any address that is
# neither APP_ORIGIN_* below (a preview, a *.vercel.app URL, localhost), and the one the UNSUFFIXED settings below apply to.
# The SDK and the CLI read the unsuffixed settings only.
NEAR_NETWORK=testnet
# Where each network is served: https://host with no path (http://localhost:<port> for development). A network is served
# when it is the default network or its origin is set; the default network's falls back to the production address.
APP_ORIGIN_MAINNET=
APP_ORIGIN_TESTNET=
# Comma-separated, in failover order
NEAR_RPC_URLS=https://rpc.testnet.fastnear.com
# Comma-separated archival RPCs (scripts, verifier, web /proof) for transaction lookups older than about 2.5 days.
# SDK and CLI default: https://archival-rpc.mainnet.fastnear.com on mainnet, the testnet URL below on testnet.
# The web has no default: unset means /proof makes no archival lookup, and an old burn shows as not proven.
NEAR_ARCHIVAL_RPC_URLS=https://archival-rpc.testnet.fastnear.com
PROBARION_FACTORY_ID=vaults.probarion.testnet
# The web app's per-network settings. Each of NEAR_RPC_URLS, NEAR_ARCHIVAL_RPC_URLS, PROBARION_FACTORY_ID,
# PROBARION_VAULT_ID, CANARY_VAULT_ID and TEAM_VAULT_IDS has a _MAINNET and a _TESTNET form. A network's value is its
# suffixed variable; else, for the default network only, the unsuffixed one; else the built-in default. An unsuffixed
# variable never applies to the other network. While both networks are served the web app refuses to start if an
# unsuffixed one is set (it names the variable): set the suffixed forms and leave the unsuffixed ones unset. An account id
# or an RPC URL that belongs to the other network (.testnet on mainnet, a host named testnet) is refused too.
NEAR_RPC_URLS_MAINNET=
NEAR_RPC_URLS_TESTNET=
NEAR_ARCHIVAL_RPC_URLS_MAINNET=
NEAR_ARCHIVAL_RPC_URLS_TESTNET=
PROBARION_FACTORY_ID_MAINNET=
PROBARION_FACTORY_ID_TESTNET=
PROBARION_VAULT_ID_MAINNET=
PROBARION_VAULT_ID_TESTNET=
CANARY_VAULT_ID_MAINNET=
CANARY_VAULT_ID_TESTNET=
TEAM_VAULT_IDS_MAINNET=
TEAM_VAULT_IDS_TESTNET=
# The vault the SDK and CLI use by default. The web opens it at /proof only when its proof page is public; for the
# web, use a public team vault the factory created. v0.probarion.testnet fails check d by design (its smoke spends
# predate the ledger), so /proof shows it in red.
PROBARION_VAULT_ID=v0.probarion.testnet
# Function-Call key, spend-only, server-side only. Format: ed25519:<secret>
PROBARION_AGENT_KEY=
# Function-Call key, anchor-only. Format: ed25519:<secret>
PROBARION_LEDGER_KEY=
# Ledger file (sdk, cli, mcp). Optional; leave empty for the default.
# Default: .probarion/ledger.jsonl for sdk and cli, ~/.probarion/<vault>/ledger.jsonl for mcp.
PROBARION_LEDGER_PATH=

# --- NEAR AI Cloud (sdk, web). Set a spend cap in the dashboard.
NEARAI_API_KEY=
# Optional. The default resolves from the public paginated GET /v1/model/list, filtered on
# providerType == "vllm", attestationSupported, verifiable and structured_outputs.
NEARAI_MODEL=

# --- 1Click (web, top-up quotes). 1Click exists on mainnet only: this one key serves the whole project and is used for
# mainnet vaults; a testnet vault is refused.
ONECLICK_JWT=

# --- Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web app
# 32-byte base64 libsodium secretbox master key for agent_keys
KEY_ENCRYPTION_SECRET=
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
CANARY_VAULT_ID=
# Comma-separated vault ids the team runs: they register as tenant kind "team" (R11). Empty = none.
TEAM_VAULT_IDS=
# Canary kill switch and cut line: live | code-only | replay | off. One switch for both networks; the daily model-token
# budget is shared by them on purpose.
CANARY_MODE=code-only
# Optional Better Stack heartbeat URL, pinged by the watcher after every run. Its path carries a
# token, so it stays empty here like a secret.
BETTERSTACK_HEARTBEAT_URL=
# Public Base RPC for settlement lookups (online verify)
BASE_RPC_URL=https://mainnet.base.org
# Protects cron endpoints
CRON_SECRET=

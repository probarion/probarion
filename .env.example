# Probarion environment variables (interfaces §14).
# Copy to .env and fill in. Never commit .env. Secrets stay empty in this file.

# --- NEAR (all packages)
NEAR_NETWORK=testnet
# Comma-separated, in failover order
NEAR_RPC_URLS=https://rpc.testnet.fastnear.com
# Comma-separated archival RPCs (scripts, verifier) for transaction lookups older than about 2.5 days.
# Default: https://archival-rpc.mainnet.fastnear.com on mainnet, the testnet URL below on testnet.
NEAR_ARCHIVAL_RPC_URLS=https://archival-rpc.testnet.fastnear.com
PROBARION_FACTORY_ID=vaults.probarion.testnet
PROBARION_VAULT_ID=v0.probarion.testnet
# Function-Call key, spend-only, server-side only. Format: ed25519:<secret>
PROBARION_AGENT_KEY=
# Function-Call key, anchor-only. Format: ed25519:<secret>
PROBARION_LEDGER_KEY=
# Ledger file (sdk, cli, mcp). Optional; leave empty for the default.
# Default: .probarion/ledger.jsonl for sdk and cli, ~/.probarion/<vault>/ledger.jsonl for mcp.
PROBARION_LEDGER_PATH=

# --- NEAR AI Cloud (sdk, web). Set a spend cap in the dashboard.
NEARAI_API_KEY=
# Optional. The default resolves from the public paginated GET /v1/model/list, filtered on
# providerType == "vllm", attestationSupported, verifiable and structured_outputs.
NEARAI_MODEL=

# --- 1Click (web, top-up quotes)
ONECLICK_JWT=

# --- Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web app
# 32-byte base64 libsodium secretbox master key for agent_keys
KEY_ENCRYPTION_SECRET=
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
CANARY_VAULT_ID=
# Canary kill switch and cut line: live | code-only | replay | off
CANARY_MODE=code-only
# Optional Better Stack heartbeat URL, pinged by the watcher after every run. Its path carries a
# token, so it stays empty here like a secret.
BETTERSTACK_HEARTBEAT_URL=
# Public Base RPC for settlement lookups (online verify)
BASE_RPC_URL=https://mainnet.base.org
# Protects cron endpoints
CRON_SECRET=

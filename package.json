{
  "name": "probarion",
  "private": true,
  "description": "Spend by mandate. Prove every payment.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "verify": "pnpm run verify:rust && pnpm run verify:ts && pnpm verify:launch",
    "verify:rust": "cargo test --manifest-path contracts/Cargo.toml --workspace --exclude integration-tests",
    "verify:ts": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test",
    "verify:full": "pnpm run verify && pnpm run contracts:build && pnpm run test:sandbox",
    "contracts:build": "bash scripts/build-contracts.sh",
    "test:sandbox": "cargo test --manifest-path contracts/Cargo.toml -p integration-tests -- --test-threads=2",
    "build": "pnpm -r --if-present run build",
    "test": "node --test \"scripts/**/*.test.mjs\" && pnpm -r --if-present run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "proof": "tsx scripts/proof.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test:scripts": "vitest run --root scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "verify:launch": "pnpm typecheck:scripts && pnpm test:scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}

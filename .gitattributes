* text=auto eol=lf
*.wasm binary
# Invoice-text fixtures: A8 rebuilds the request from their exact bytes (plan 03 Task 14), so git never converts them.
packages/core/test/fixtures/invoice-*.txt -text
# The demo vault's invoices and PO: their sha256 is on chain, so git never converts them either.
docs/evidence/demo-vault/*.txt -text
# The 2026-11 mainnet demo: the PO and invoice hashes go on chain (purpose_hash, invoice_hash), so git never converts them.
docs/evidence/mainnet-v0/*.txt -text
# The site's byte copies for the no-clone mainnet verify: their sha256 must equal their sources', so git leaves their bytes as they are.
apps/web/public/samples/mainnet/** -text
# The demo vault's payments CSV: RFC 4180 CRLF line ends and a BOM, compared byte for byte by test/demo-vault.test.ts.
docs/evidence/demo-vault/*.csv -text
# The eval dataset: an invoice hash is the sha256 of the exact text and a purpose_hash of the exact document bytes, so git never converts them.
eval/invoices/*.txt -text
eval/purpose/*.txt -text
eval/invoices/*.pdf binary
# The 402 demo mandate's purpose: its sha256 goes on chain as the mandate's purpose_hash, so git never converts it.
examples/402/demo-purpose.txt -text
# S1 on mainnet (2026-11-13): the invoice and PO hashes are on chain and the ledger is kept byte for byte, so git never converts the folder.
docs/evidence/mainnet-v0/s1-2026-11-13/* -text
# S2 on mainnet (2026-11-13): the invoice and PO hashes are on chain and the ledger is kept byte for byte, so git never converts the folder.
docs/evidence/mainnet-v0/s2-2026-11-13/* -text
